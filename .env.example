# Idea Map API settings (apps/api/src/config.ts). Names only: set the values in your
# environment or a secret store, never in the repo (F5-S8).

# Postgres. The API switches to the ideamap_app role in every transaction.
DATABASE_URL=
PORT=

# Origins the teacher and student apps are served from, comma-separated.
IDEAMAP_APP_ORIGINS=
# At least 32 random bytes. Encrypts the sign-in cookie and derives CSRF tokens.
IDEAMAP_SESSION_SECRET=
# Idle limits in minutes (default 480 for staff, 120 for students) and the absolute
# session limit in hours (default 12).
IDEAMAP_SESSION_IDLE_MINUTES_STAFF=
IDEAMAP_SESSION_IDLE_MINUTES_STUDENT=
IDEAMAP_SESSION_MAX_HOURS=
# Failed sign-in callbacks one IP may make per minute (default 20).
IDEAMAP_SIGNIN_FAILURES_PER_MINUTE=
# 1 behind a reverse proxy that sets X-Forwarded-For, -Host and -Proto.
IDEAMAP_TRUST_PROXY=

# SSO providers to show, comma-separated: google, clever, classlink, or any other id.
IDEAMAP_SSO_PROVIDERS=
# Per provider, with <ID> upper-cased. ISSUER, LABEL and TENANT_CLAIM have defaults for
# google, clever and classlink; SCOPES defaults to "openid email profile".
IDEAMAP_SSO_GOOGLE_CLIENT_ID=
IDEAMAP_SSO_GOOGLE_CLIENT_SECRET=
IDEAMAP_SSO_CLEVER_CLIENT_ID=
IDEAMAP_SSO_CLEVER_CLIENT_SECRET=
IDEAMAP_SSO_CLASSLINK_CLIENT_ID=
IDEAMAP_SSO_CLASSLINK_CLIENT_SECRET=
# Optional overrides, for any provider:
# IDEAMAP_SSO_<ID>_ISSUER=
# IDEAMAP_SSO_<ID>_LABEL=
# IDEAMAP_SSO_<ID>_TENANT_CLAIM=
# IDEAMAP_SSO_<ID>_SCOPES=
# 1 only for the local mock provider (http). Refused when NODE_ENV=production.
IDEAMAP_SSO_ALLOW_HTTP=

# AI gateway (apps/api/src/ai). Without a key the gateway's routes are left out. The key
# is read only here, on the server; it never reaches a browser (A1-S1).
IDEAMAP_AI_API_KEY=
# Model id (default claude-opus-5-5), and "off" to turn off the server-side refusal
# fallback for a model that doesn't support it.
IDEAMAP_AI_MODEL=
IDEAMAP_AI_FALLBACKS=
# Reply size in tokens (default 2000) and provider timeout in ms (default 30000).
IDEAMAP_AI_MAX_TOKENS=
IDEAMAP_AI_TIMEOUT_MS=
# How long a moderation check may take before the student's turn fails closed (default 5000).
IDEAMAP_AI_MODERATION_TIMEOUT_MS=
# Calls per minute for one student (default 10) and one class (default 120).
IDEAMAP_AI_STUDENT_PER_MINUTE=
IDEAMAP_AI_CLASS_PER_MINUTE=
