[
  {
    "tab": "Course",
    "kind": "keyvalue",
    "desc": "One row of key/value pairs that names the map and sets the reading level.",
    "cols": [
      {
        "name": "subject",
        "type": "text",
        "req": true,
        "edit": "both",
        "missing": "Blocks import",
        "example": "Science",
        "note": ""
      },
      {
        "name": "topic",
        "type": "text",
        "req": true,
        "edit": "both",
        "missing": "Blocks import",
        "example": "The water cycle",
        "note": "Map title shown to students"
      },
      {
        "name": "grade",
        "type": "K | 1–12",
        "req": true,
        "edit": "both",
        "missing": "Blocks import",
        "example": "6",
        "note": "Sets every persona's {age}, {style} and {length}"
      },
      {
        "name": "framework",
        "type": "text",
        "req": false,
        "edit": "both",
        "missing": "Custom",
        "example": "NGSS",
        "note": "Labels the standards codes"
      },
      {
        "name": "map_objective",
        "type": "text",
        "req": false,
        "edit": "both",
        "missing": "Hidden on the map",
        "example": "Explain how water moves around the Earth…",
        "note": ""
      },
      {
        "name": "pass_mark",
        "type": "percent",
        "req": false,
        "edit": "app",
        "missing": "70",
        "example": "70",
        "note": "Quiz and teach-back threshold"
      }
    ]
  },
