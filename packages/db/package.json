{
  "name": "@ideamap/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@ideamap/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "node dist/cli.js up",
    "migrate:down": "node dist/cli.js down",
    "migrate:status": "node dist/cli.js status",
    "reset": "node dist/cli.js reset"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@ideamap/contracts": "workspace:*",
    "kysely": "0.29.7",
    "pg": "8.23.1",
    "pg-boss": "12.38.0"
  }
}
