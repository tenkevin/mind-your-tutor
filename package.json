{
  "name": "ideamap",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose -f packages/db/compose.yaml up -d --wait",
    "db:stop": "docker compose -f packages/db/compose.yaml down",
    "db:migrate": "pnpm --filter @ideamap/db... build && pnpm --filter @ideamap/db migrate",
    "db:status": "pnpm --filter @ideamap/db... build && pnpm --filter @ideamap/db migrate:status",
    "db:reset": "pnpm --filter @ideamap/db... build && pnpm --filter @ideamap/db reset"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
